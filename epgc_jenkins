pipeline {
    agent none
    environment {
      DOCKERHUB_CREDENTIALS = credentials("15893927-a84b-4b02-ae64-e8a61fd7d63b")   
    } 
    stages {
        stage( 'stage') {
          agent {
            label "K8S_Master"
           }
           steps {
             script {
                git branch: 'gh-pages', url: 'https://github.com/JavidGull/DevOps_EPGC.git'
              }    
            }
        }
		stage( 'docker_push' ) {
          agent {
            label "K8S_Master"
          }
          steps {
            script {
             sh ''' 
                sudo docker build . -t javidgull/devops_epgc_project               
                sudo docker login -u ${DOCKERHUB_CREDENTIALS_USR} -p ${DOCKERHUB_CREDENTIALS_PSW}
                sudo docker push javidgull/devops_epgc_project
             '''    
            }    
          }
        }
        stage( 'K8S_Deploy' ) {
          agent {
            label "K8S_Master"
          }
          steps {
            script {
              dir('data'){
                sh '''
                  #kubectl delete -f epgc_deploy.yaml  
                  kubectl create -f epgc_deploy.yaml
                '''               
              }
            }
          }
        }  
    }
}
